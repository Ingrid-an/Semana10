# Copia este archivo como ".env" y completa con tus datos reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto del servidor
PORT=3000

# Conexión a MySQL (XAMPP por defecto: usuario root, sin contraseña)
DB_HOST=localhost
